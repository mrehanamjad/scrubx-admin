# ==============================================================================
# ScrubX Admin - Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env.local and populate the values for local development:
#   cp .env.example .env.local
#
# NOTE: Never commit .env.local or expose private keys to the client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE MANAGED POSTGRESQL (DATABASE LAYER)
# ------------------------------------------------------------------------------
# Primary connection string for Drizzle ORM.
# Recommended for Next.js / Serverless:
# Use Supavisor Transaction Pooler on port 6543 with sslmode=require:
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Direct connection string (Session Pooler or Direct DB on port 5432)
# Required only if executing schema migrations via drizzle-kit push on port 5432:
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. BETTER AUTH CONFIGURATION (PHASE 2)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random string: openssl rand -hex 32
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin bootstrap (required for `npm run auth:seed-admin`) — never commit real values
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""          # required, min 12 chars (openssl rand -base64 24)
ADMIN_NAME="Administrator"
ADMIN_ROLE="super_admin"   # super_admin | admin | staff

# ------------------------------------------------------------------------------
# 3. IMAGEKIT CONFIGURATION (PHASE 4)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_placeholder"
IMAGEKIT_PRIVATE_KEY="private_placeholder"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/scrubx"
